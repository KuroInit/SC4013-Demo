FROM python:3.13-alpine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 POLICY_MODE=vulnerable
WORKDIR /app
COPY victim_service.py /app/victim_service.py
COPY victim/portal.html /app/index.html
COPY victim/security.html /app/security.html
USER 10001:10001
EXPOSE 443
ENTRYPOINT ["python", "-B", "/app/victim_service.py"]
